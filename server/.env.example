# Copy to server/.env for local overrides. Variables already set in the
# environment win over this file.

# HTTP API, signaling and the built web client.
MEET_HTTP_ADDR=:8088

# Every media connection shares one UDP port; open it in the firewall.
MEET_RTC_UDP_PORT=7882
# ICE over TCP for networks that block UDP. 0 disables it.
MEET_RTC_TCP_PORT=7881

# Behind 1:1 NAT (most cloud VMs) the server only sees its private address.
# Set the public IP here or browsers will be handed candidates they can't reach.
# MEET_PUBLIC_IP=203.0.113.10

# Interfaces never offered as candidates (prefix match).
# MEET_RTC_EXCLUDE_INTERFACES=docker,br-,veth,virbr,lxc,tailscale
# MEET_RTC_IPV6=false

# STUN/TURN handed to browsers. Usually unnecessary: the SFU is reachable
# directly. A TURN server helps the most locked-down networks.
# MEET_ICE_SERVERS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# MEET_TURN_USERNAME=
# MEET_TURN_CREDENTIAL=

# Origins (besides the server's own) allowed to call the API and open sockets.
MEET_ALLOWED_ORIGINS=http://localhost:5188,http://127.0.0.1:5188
# Take client addresses from X-Forwarded-For (only behind a proxy that sets it).
# MEET_TRUST_PROXY=false

MEET_DATA_DIR=./data
# The built client. Defaults to ../web/dist when it exists.
# MEET_WEB_DIR=../web/dist

MEET_MAX_PARTICIPANTS=50
MEET_RECONNECT_GRACE=20s
MEET_MEETING_TTL=2160h
MEET_LOG_LEVEL=info
